{
  "name": "unemployment-mcp",
  "version": "0.1.0",
  "description": "Unemployment MCP 😭 — AI replacing jobless activities: MyMSD (my.msd.govt.nz) and DES (new.my.msd.govt.nz, MSD's jobs site) over their own HTTP APIs, no browser in the loop",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "msd",
    "mymsd",
    "des",
    "work-and-income",
    "new-zealand",
    "jobs",
    "claude",
    "unemployment"
  ],
  "author": "ezydubs",
  "license": "ISC",
  "type": "module",
  "bin": {
    "unemployment-mcp": "dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "cloakbrowser": "0.5.11",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezydubs/unemployment-mcp.git"
  },
  "homepage": "https://github.com/ezydubs/unemployment-mcp#readme"
